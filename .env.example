# Copy this file to .env.local and fill in your values.
# Get a free Blockfrost project ID at https://blockfrost.io
#
# The app automatically follows the wallet's network (mainnet/testnet).
# Provide keys for whichever networks you need.

# --- Testnet (Preprod) ---
NEXT_PUBLIC_BLOCKFROST_TESTNET_API_KEY=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_BLOCKFROST_TESTNET_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
NEXT_PUBLIC_CARDANOSCAN_TESTNET_BASE_URL=https://preprod.cardanoscan.io

# --- Mainnet ---
NEXT_PUBLIC_BLOCKFROST_MAINNET_API_KEY=mainnetXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_BLOCKFROST_MAINNET_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0
NEXT_PUBLIC_CARDANOSCAN_MAINNET_BASE_URL=https://cardanoscan.io

# --- Legacy (optional, used as fallback for testnet if _TESTNET_ vars are not set) ---
# NEXT_PUBLIC_BLOCKFROST_API_KEY=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# NEXT_PUBLIC_BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0
# NEXT_PUBLIC_CARDANOSCAN_BASE_URL=https://preprod.cardanoscan.io
