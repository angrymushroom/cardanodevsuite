# Copy this file to .env.local and fill in your values.
# Get a free Blockfrost project ID at https://blockfrost.io

# Your Blockfrost project ID (required for Contract Simulator and Deploy Contract)
NEXT_PUBLIC_BLOCKFROST_API_KEY=preprodXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Blockfrost API base URL — change to mainnet if needed
NEXT_PUBLIC_BLOCKFROST_BASE_URL=https://cardano-preprod.blockfrost.io/api/v0

# Cardanoscan explorer base URL — change to mainnet if needed
NEXT_PUBLIC_CARDANOSCAN_BASE_URL=https://preprod.cardanoscan.io
